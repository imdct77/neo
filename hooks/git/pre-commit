#!/usr/bin/env bash
# Neo V1 — Git pre-commit Hook
# 설치: cp git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# 또는: pre-commit install (pre-commit 패키지 사용 시)
#
# 커밋 시점에 자동 실행:
#   1. pytest — 단위 테스트
#   2. ruff   — Python 린트·포맷
#   3. bandit — Python 보안 스캔
#   4. ESLint — TypeScript 린트
#   5. prettier — TypeScript 포맷
#   6. detect-secrets — 민감 키 하드코딩 방지
#   7. pip-audit — Python 의존성 취약점 스캔
#   8. npm audit — Node.js 의존성 취약점 스캔
#   9. 브랜치 보호 — main/develop 직접 커밋 차단

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

pass() { echo -e "${GREEN}✓${NC} $1"; }
fail() { echo -e "${RED}✗${NC} $1"; exit 1; }
warn() { echo -e "${YELLOW}⚠${NC} $1"; }
info() { echo -e "  $1"; }

echo ""
echo "Neo V1 pre-commit 검사 시작..."
echo "================================"

# --------------------------------------------------------
# 1. 브랜치 보호 — main/develop 직접 커밋 차단
# --------------------------------------------------------
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
if [[ "$BRANCH" == "main" || "$BRANCH" == "develop" ]]; then
    fail "브랜치 보호: $BRANCH 브랜치에 직접 커밋할 수 없습니다. feature/ 브랜치를 사용하세요."
fi
pass "브랜치 보호 ($BRANCH)"

# --------------------------------------------------------
# 2. 민감 키 하드코딩 방지
# --------------------------------------------------------
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)

if [[ -n "$STAGED_FILES" ]]; then
    SECRETS_PATTERNS=(
        "password\s*=\s*['\"][^'\"]{4,}['\"]"
        "api_key\s*=\s*['\"][^'\"]{4,}['\"]"
        "secret\s*=\s*['\"][^'\"]{8,}['\"]"
        "AWS_SECRET_ACCESS_KEY\s*=\s*['\"][^'\"]{4,}['\"]"
        "-----BEGIN.*PRIVATE KEY-----"
    )

    FOUND_SECRET=0
    for pattern in "${SECRETS_PATTERNS[@]}"; do
        if git diff --cached | grep -qP "$pattern" 2>/dev/null; then
            FOUND_SECRET=1
            break
        fi
    done

    if [[ $FOUND_SECRET -eq 1 ]]; then
        fail "민감 키 감지: 하드코딩된 시크릿이 있습니다. .env 파일을 사용하세요."
    fi
    pass "민감 키 스캔"
fi

# --------------------------------------------------------
# 3. Python 검사 (변경된 .py 파일이 있을 때만)
# --------------------------------------------------------
PY_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)

if [[ -n "$PY_FILES" ]]; then
    # ruff 린트
    if command -v ruff &>/dev/null; then
        if ! ruff check $PY_FILES --quiet 2>/dev/null; then
            fail "ruff 린트 실패. 'ruff check --fix .' 로 자동 수정하세요."
        fi
        pass "ruff 린트"
    else
        warn "ruff 미설치 (건너뜀)"
    fi

    # pytest (exit code 5 = no tests collected → 허용)
    if command -v pytest &>/dev/null; then
        pytest --tb=short -q 2>/dev/null; pyret=$?
        if [ $pyret -ne 0 ] && [ $pyret -ne 5 ]; then
            fail "pytest 실패 (exit=$pyret). 테스트를 통과시킨 후 커밋하세요."
        fi
        pass "pytest"
    else
        warn "pytest 미설치 (건너뜀)"
    fi

    # 하네스 자체 테스트 (python3만 필요, pytest 불필요)
    for t in hooks/test_neo_checks.py hooks/test_neo_security.py; do
        if [ -f "$t" ]; then
            python3 "$t" || fail "하네스 테스트 실패: $t"
            pass "하네스 테스트 ($(basename $t))"
        fi
    done

    # bandit 보안 스캔
    if command -v bandit &>/dev/null; then
        if ! bandit -r . -ll -q --exclude .venv,venv,node_modules 2>/dev/null; then
            fail "bandit 보안 스캔 실패. 고위험 보안 이슈를 수정하세요."
        fi
        pass "bandit 보안 스캔"
    else
        warn "bandit 미설치 (건너뜀)"
    fi

    # pip-audit 의존성 취약점 스캔
    if command -v pip-audit &>/dev/null; then
        if ! pip-audit --ignore-vuln PYSEC-0000-CPE 2>/dev/null; then
            fail "pip-audit: Critical·High 의존성 취약점 발견. 수정 후 커밋하세요."
        fi
        pass "pip-audit 의존성 스캔"
    else
        warn "pip-audit 미설치 (건너뜀). pip install pip-audit"
    fi
fi

# --------------------------------------------------------
# 4. TypeScript 검사 (변경된 .ts/.tsx 파일이 있을 때만)
# --------------------------------------------------------
TS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' || true)

if [[ -n "$TS_FILES" ]]; then
    # ESLint
    if command -v npx &>/dev/null && [[ -f ".eslintrc*" || -f "eslint.config*" ]]; then
        if ! npx eslint $TS_FILES --quiet 2>/dev/null; then
            fail "ESLint 실패. 린트 오류를 수정하세요."
        fi
        pass "ESLint"
    else
        warn "ESLint 설정 없음 (건너뜀)"
    fi

    # prettier
    if command -v npx &>/dev/null && [[ -f ".prettierrc*" || -f "prettier.config*" ]]; then
        if ! npx prettier --check $TS_FILES 2>/dev/null; then
            fail "prettier 포맷 실패. 'npx prettier --write .' 로 자동 수정하세요."
        fi
        pass "prettier 포맷"
    else
        warn "prettier 설정 없음 (건너뜀)"
    fi

    # npm audit 의존성 취약점 스캔
    if command -v npm &>/dev/null && [[ -f "package.json" ]]; then
        if ! npm audit --audit-level=high 2>/dev/null; then
            fail "npm audit: Critical·High 의존성 취약점 발견. 수정 후 커밋하세요."
        fi
        pass "npm audit 의존성 스캔"
    else
        warn "npm/package.json 없음 (건너뜀)"
    fi
fi

# --------------------------------------------------------
# 5. Neo substrate 게이트 (보안 패턴 + 상태 검증)
# --------------------------------------------------------
NEO_GATE="$(dirname "$0")/../neo_precommit_gate.py"
if [ -f "$NEO_GATE" ]; then
    if ! python3 "$NEO_GATE"; then
        fail "Neo substrate 게이트 차단됨"
    fi
    pass "Neo substrate 게이트"
fi

# --------------------------------------------------------
# 6. 메타 인덱스 동기화
# --------------------------------------------------------
META_CHECK="$(dirname "$0")/../meta_consistency_check.py"
if [ -f "$META_CHECK" ]; then
    python3 "$META_CHECK" --sync 2>/dev/null
    pass "메타 인덱스 동기화"
fi

echo "================================"
echo -e "${GREEN}모든 검사 통과. 커밋 진행합니다.${NC}"
echo ""
